{
  "name": "@lampgenie/runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./agent/*": {
      "types": "./src/agent/*.ts",
      "development": "./src/agent/*.ts",
      "default": "./dist/agent/*.js"
    },
    "./concurrency/*": {
      "types": "./src/concurrency/*.ts",
      "development": "./src/concurrency/*.ts",
      "default": "./dist/concurrency/*.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "./locks/*": {
      "types": "./src/locks/*.ts",
      "development": "./src/locks/*.ts",
      "default": "./dist/locks/*.js"
    },
    "./team/*": {
      "types": "./src/team/*.ts",
      "development": "./src/team/*.ts",
      "default": "./dist/team/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "NODE_OPTIONS=--conditions=development vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lampgenie/core": "workspace:*",
    "@lampgenie/protocol": "workspace:*",
    "glob": "^13.0.6",
    "gpt-tokenizer": "4.1.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}